<!DOCTYPE html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="StumpCloud fleet monitor: sites, hosts, VMs and containers with hardware metrics."
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="binnacle">{assigns[:page_title]}</.live_title>

    <!--
      Theme bootstrap. This MUST stay inline and MUST stay above the
      stylesheet link: it runs before first paint, so the correct palette is
      on <html> by the time any pixel is drawn. Three-state, matching the
      design system: an explicit choice wins, otherwise follow the OS.
      Storing only an explicit choice is what lets a user who has not chosen
      keep tracking their OS when it changes.

      The nonce comes from BinnacleWeb.Plugs.SecurityHeaders so CSP
      script-src allows only this one inline script.
    -->
    <script nonce={assigns[:csp_nonce]}>
      (function () {
        try {
          var saved = localStorage.getItem("binnacle-theme");
          var prefersDay =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme = saved || (prefersDay ? "day" : "night");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          /* Private mode / storage disabled: the markup default (night) stands. */
        }
      })();
    </script>

    <!--
      Fonts are self-hosted under /fonts and loaded via @font-face
      declarations in assets/styles/fonts.css (imported by app.css).
      No remote origins — the CSP stays locked to style-src 'self'
      and font-src 'self'. The three families are the design system's
      whole type stack:

      JetBrains Mono = body/UI/code · Space Mono = display · Silkscreen = pixel accent.
    -->

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <noscript>
      <p class="noscript-message">
        binnacle needs JavaScript — the interface is a Phoenix LiveView.
      </p>
    </noscript>
  </body>
</html>
