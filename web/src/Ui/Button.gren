module Ui.Button exposing
    ( Size(..)
    , Variant(..)
    , danger
    , ghost
    , primary
    , secondary
    , view
    )

{-| Buttons.

Governing: ADR-0001 (Tailwind v4 + daisyUI; classes as plain strings).

Built on daisyUI's `btn` so the interaction states, disabled handling and sizing
scaffolding come from the framework rather than from us, with the Bubbletea
treatment layered on top: mono type, hairline border, and — because this is the
design system's *browser* dialect — a spring lift plus neon bloom on hover.

Note what is deliberately absent: no colour literals and no `dark:` variants.
`btn-primary` resolves through the daisyUI theme blocks in `theme.css`, which
resolve to the design tokens, which flip on `data-theme`. One class, correct in
both palettes.

The lift is listed property-by-property rather than `transition-all`. The design
system calls that out explicitly, and the reason is real: `all` also catches the
initial style application, which can animate layout properties on first paint.

@docs Size, Variant, danger, ghost, primary, secondary, view

-}

import Transmutable.Html as H exposing (Html)
import Transmutable.Html.Attributes as A
import Transmutable.Html.Events as E


{-| -}
type Variant
    = Primary
    | Secondary
    | Ghost
    | Danger


{-| -}
type Size
    = Small
    | Medium
    | Large


variantClass : Variant -> String
variantClass variant =
    when variant is
        Primary ->
            "btn-primary"

        Secondary ->
            "btn-secondary"

        Ghost ->
            "btn-ghost border-line"

        Danger ->
            "btn-error"


sizeClass : Size -> String
sizeClass size =
    when size is
        Small ->
            "btn-sm text-2xs"

        Medium ->
            "btn-sm text-xs"

        Large ->
            "btn-md text-sm"


{-| Hover bloom, matched to the variant. Ghost gets none: it is the quiet
option, and a glowing quiet option is a contradiction that also makes toolbars
of mostly-ghost buttons twinkle.
-}
glowClass : Variant -> String
glowClass variant =
    when variant is
        Primary ->
            "hover:shadow-glow-purple"

        Secondary ->
            "hover:shadow-glow-pink"

        Ghost ->
            ""

        Danger ->
            ""


{-| The full button.

`onPress` is a `Maybe msg`: `Nothing` renders a genuinely disabled control
rather than a live one that ignores clicks. That keeps the visual state and the
DOM state from disagreeing, so keyboard and assistive-tech users get the same
answer the styling gives.

-}
view :
    { variant : Variant
    , size : Size
    , onPress : Maybe msg
    , label : String
    }
    -> Html msg
view config =
    let
        base =
            "btn font-mono font-bold tracking-wide normal-case rounded-md "
                ++ "transition-[transform,box-shadow,background-color,border-color] "
                ++ "duration-[120ms] ease-spring hover:-translate-y-px "
                ++ "active:translate-y-0 disabled:opacity-40 disabled:hover:translate-y-0"

        classes =
            String.join " "
                [ base
                , variantClass config.variant
                , sizeClass config.size
                , glowClass config.variant
                ]

        handler =
            when config.onPress is
                Just msg ->
                    [ E.onClick msg ]

                Nothing ->
                    [ A.disabled True ]
    in
    H.button
        (Array.pushFirst (A.class classes) handler)
        [ H.text config.label ]


{-| `Ui.Button.primary "brew" Refresh` — the common case without the record.
-}
primary : String -> msg -> Html msg
primary label msg =
    view { variant = Primary, size = Medium, onPress = Just msg, label = label }


{-| -}
secondary : String -> msg -> Html msg
secondary label msg =
    view { variant = Secondary, size = Medium, onPress = Just msg, label = label }


{-| -}
ghost : String -> msg -> Html msg
ghost label msg =
    view { variant = Ghost, size = Medium, onPress = Just msg, label = label }


{-| -}
danger : String -> msg -> Html msg
danger label msg =
    view { variant = Danger, size = Medium, onPress = Just msg, label = label }
