module Ui.Theme exposing
    ( Theme(..)
    , all
    , fromString
    , label
    , storageKey
    , toString
    , toggle
    )

{-| The two palettes the Bubbletea design system ships, as a type.

Governing: ADR-0001 (Gren full-stack; Tailwind v4 + daisyUI as the CSS layer).

The whole theming mechanism is one attribute: `data-theme` on `<html>`. Both
the design tokens (`[data-theme="day"]` re-points every custom property) and
daisyUI (which switches components on the same attribute) read it, which is why
`Ui.Theme` never touches a colour. It owns the *name* and the persistence key;
CSS owns everything the name means.

That separation is the reason no view in this app needs a `dark:` variant or a
palette branch: a component asks for `bg-surface`, and which surface that is has
already been decided by the attribute.

@docs Theme, all, fromString, label, storageKey, toString, toggle

-}


{-| `Night` is the native habitat — the design system's `:root`. `Day` is the
light terminal theme, scoped to `[data-theme="day"]`.
-}
type Theme
    = Night
    | Day


{-| Every theme, in the order a picker should offer them.
-}
all : Array Theme
all =
    [ Night, Day ]


{-| The attribute value. These two strings are a contract with three other
places — `index.html`'s bootstrap script, the `[data-theme="day"]` scope in
`tokens/colors.css`, and the daisyUI theme names in `theme.css`. Changing one
without the others silently half-applies a theme, so they are spelled out here
once and referenced everywhere else.
-}
toString : Theme -> String
toString theme =
    when theme is
        Night ->
            "night"

        Day ->
            "day"


{-| Parse a stored or attribute value.

Returns `Nothing` rather than defaulting to `Night`, because "no stored choice"
and "stored Night" must stay distinguishable: a user who has never chosen should
keep following their OS preference, and collapsing the two here would pin them to
night the first time they loaded the page.

-}
fromString : String -> Maybe Theme
fromString raw =
    when raw is
        "night" ->
            Just Night

        "day" ->
            Just Day

        _ ->
            Nothing


{-| Human-facing name for a toggle or menu.
-}
label : Theme -> String
label theme =
    when theme is
        Night ->
            "night"

        Day ->
            "day"


{-| The other theme. With exactly two, a toggle is total — adding a third
variant turns every call site into a compile error, which is the intended
warning rather than a silent wrong-neighbour bug.
-}
toggle : Theme -> Theme
toggle theme =
    when theme is
        Night ->
            Day

        Day ->
            Night


{-| `localStorage` key. App-scoped rather than the design system's own
`btds-theme`: binnacle and any other Bubbletea-styled surface on
`*.pages.stump.rocks` share an origin, so a shared key would make one app's
toggle silently retheme the other.

Must match the string in `index.html`'s bootstrap script.

-}
storageKey : String
storageKey =
    "binnacle-theme"
