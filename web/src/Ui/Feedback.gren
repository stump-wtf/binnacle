module Ui.Feedback exposing
    ( braille
    , cursor
    , dots
    , keyHint
    , moon
    , spinner
    , spinnerFrame
    )

{-| Spinners, the block cursor, and the help footer.

Governing: ADR-0001 (Gren full-stack; no icon package — glyphs are the icon set).

Three small things that together do most of the work of making a web surface
read as terminal-native:

**Spinners cycle glyph frames**, they do not rotate an SVG. The frame is a
function of a tick counter held in the caller's model, which keeps these
functions pure and — more usefully — keeps every spinner on screen in lockstep
off one subscription, instead of each drifting on its own CSS animation clock.

**The block cursor** is the heartbeat of the system: hard on/off at `steps(1)`,
never a fade. It is a CSS utility (`cursor-block`, defined in `theme.css`)
because it must keep blinking while Gren is idle.

**The help footer** is load-bearing, not decoration. The design system requires
every screen to end in a dim row of `key action` pairs joined by bullets.

@docs braille, cursor, dots, keyHint, moon, spinner, spinnerFrame

-}

import Math
import Transmutable.Html as H exposing (Html)
import Transmutable.Html.Attributes as A


{-| The Bubbles default — dense, fast, unobtrusive.
-}
braille : Array String
braille =
    [ "⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷" ]


{-| Lighter weight; better next to small text.
-}
dots : Array String
dots =
    [ "⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏" ]


{-| The one place the design system sanctions emoji inside UI, because Bubbles
itself ships this spinner. Double-width cells — do not put it in a fixed
one-cell column.
-}
moon : Array String
moon =
    [ "🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘" ]


{-| Pick the frame for a tick. Wraps with `modBy`, so the caller's counter can
increment forever without special-casing overflow.

Returns `"⠿"` for an empty frame array rather than crashing — a spinner is
never important enough to take the page down.

-}
spinnerFrame : Array String -> Int -> String
spinnerFrame frames tick =
    when Array.get (Math.modBy (Array.length frames) tick) frames is
        Just frame ->
            frame

        Nothing ->
            "⠿"


{-| A spinner with a label: `⣻ steeping…`.

The glyph is `aria-hidden` and the label carries the meaning — announcing a
changing braille character on every tick would be noise, and the label is what
the user actually needs.

-}
spinner : { frames : Array String, tick : Int, label : String } -> Html msg
spinner config =
    H.span
        [ A.class "inline-flex items-center gap-2 font-mono text-sm text-muted"
        , A.attribute "role" "status"
        ]
        [ H.span
            [ A.class "text-neon-cyan"
            , A.attribute "aria-hidden" "true"
            ]
            [ H.text (spinnerFrame config.frames config.tick) ]
        , H.text config.label
        ]


{-| The blinking block cursor. Purely decorative, so it is hidden from the
accessibility tree.
-}
cursor : Html msg
cursor =
    H.span
        [ A.class "cursor-block"
        , A.attribute "aria-hidden" "true"
        ]
        []


{-| The help footer: `↑/↓ navigate • enter select • q quit`.

Every screen ends with one. Keys render in the accent hue and actions in dim
text, which is what makes the pairs scannable rather than a grey sentence.

-}
keyHint : Array { key : String, action : String } -> Html msg
keyHint pairs =
    let
        pair index item =
            H.span
                [ A.class "inline-flex items-center gap-1.5" ]
                (Array.flatten
                    [ if index == 0 then
                        []

                      else
                        [ H.span [ A.class "px-1 text-line-bright" ] [ H.text "•" ] ]
                    , [ H.kbd
                            [ A.class "font-mono font-bold text-charm-pink" ]
                            [ H.text item.key ]
                      , H.span [ A.class "text-dim" ] [ H.text item.action ]
                      ]
                    ]
                )
    in
    H.div
        [ A.class "flex flex-wrap items-center gap-x-1 gap-y-1 font-mono text-xs" ]
        (Array.indexedMap pair pairs)
