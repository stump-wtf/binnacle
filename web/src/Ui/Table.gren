module Ui.Table exposing
    ( Column
    , column
    , numeric
    , view
    )

{-| The fleet table — dense, scannable, keyboard-selectable.

Governing: ADR-0002 (sites → hosts → VMs → containers).

This is the primary way binnacle shows the fleet, so it is built around scanning
a column rather than reading a row:

  - **Selection is a pink inset rail plus a surface tint**, mirroring the `>`
    cursor a Bubbles list draws. Not a full-row highlight — that would fight the
    status hues the row is carrying.
  - **Numeric columns are `tabular-nums` and right-aligned** (`numeric` below).
    Proportional digits in a metrics column make a vertical scan useless because
    the decimal points wander.
  - **Headers are dim, uppercase, wide-tracked** — present but never competing
    with the data.

Generic over the row type: a `Column a` knows how to pull one cell out of an
`a`, so the same table renders hosts, VMs or containers without a per-level
copy.

@docs Column, column, numeric, view

-}

import Transmutable.Html as H exposing (Html)
import Transmutable.Html.Attributes as A
import Transmutable.Html.Events as E


{-| One column: a header label, a cell renderer, and whether it is numeric.

`render` returns `Html` rather than `String` so a cell can be a status badge or
a meter — which is most of the point of a fleet table.

-}
type alias Column a msg =
    { header : String
    , render : a -> Html msg
    , alignRight : Bool
    }


{-| A normal, left-aligned column.
-}
column : String -> (a -> Html msg) -> Column a msg
column header render =
    { header = header, render = render, alignRight = False }


{-| A right-aligned, tabular-figures column. Use for anything the eye scans
vertically: percentages, temperatures, counts, uptimes.
-}
numeric : String -> (a -> Html msg) -> Column a msg
numeric header render =
    { header = header, render = render, alignRight = True }


{-| The table.

`onSelect` is `Maybe (a -> msg)`: a table that is merely a readout should pass
`Nothing` and get no pointer affordances, rather than rows that look clickable
and do nothing.

-}
view :
    { columns : Array (Column a msg)
    , rows : Array a
    , isSelected : a -> Bool
    , onSelect : Maybe (a -> msg)
    , empty : String
    }
    -> Html msg
view config =
    let
        alignClass col =
            if col.alignRight then
                "text-right tabular-nums"

            else
                "text-left"

        headerCell col =
            H.th
                [ A.class
                    ("px-3 py-2 font-mono text-2xs font-bold uppercase tracking-wide "
                        ++ "text-dim "
                        ++ alignClass col
                    )
                ]
                [ H.text col.header ]

        bodyRow row =
            let
                selected =
                    config.isSelected row

                selectionClass =
                    if selected then
                        "tint-primary rail-active"

                    else
                        ""

                interactive =
                    when config.onSelect is
                        Just toMsg ->
                            [ E.onClick (toMsg row)
                            , A.class "cursor-pointer hover:bg-surface-3"
                            , A.attribute "tabindex" "0"
                            , A.attribute "aria-selected"
                                (if selected then
                                    "true"

                                 else
                                    "false"
                                )
                            ]

                        Nothing ->
                            []
            in
            H.tr
                (Array.pushFirst
                    (A.class
                        ("border-b border-line-dim transition-[background-color] "
                            ++ "duration-[120ms] ease-out "
                            ++ selectionClass
                        )
                    )
                    interactive
                )
                (Array.map
                    (\col ->
                        H.td
                            [ A.class ("px-3 py-2 text-sm text-body " ++ alignClass col) ]
                            [ col.render row ]
                    )
                    config.columns
                )

        body =
            if Array.length config.rows == 0 then
                [ H.tr
                    []
                    [ H.td
                        [ A.attribute "colspan"
                            (String.fromInt (Array.length config.columns))
                        , A.class "px-3 py-8 text-center font-mono text-sm text-dim"
                        ]
                        [ H.text config.empty ]
                    ]
                ]

            else
                Array.map bodyRow config.rows
    in
    H.div
        [ A.class "overflow-x-auto rounded-md border border-line bg-surface" ]
        [ H.table
            [ A.class "w-full border-collapse" ]
            [ H.thead
                [ A.class "border-b border-line bg-surface-2" ]
                [ H.tr [] (Array.map headerCell config.columns) ]
            , H.tbody [] body
            ]
        ]
